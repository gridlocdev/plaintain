<Project Sdk="Microsoft.NET.Sdk">

  <!--
    `plaintain` — a launcher, plus exactly one read-only probe (PRD §9). It opens files in
    Plaintain.Desktop, and `plaintain info` prints what a text file is made of. It is deliberately not the
    start of a verb surface: a plaintext editor has no operations a shell doesn't already have.

    The binary is the app's full name, so there is no abbreviation to remember.

    GOLDEN RULE: no Avalonia, no network. Plaintain.Text + System.CommandLine + the non-UI shared
    library (Plaintain.Components.Core: the shared CliException + CliHost run harness).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Plaintain.Cli</RootNamespace>
    <AssemblyName>plaintain</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\Plaintain.Text\Plaintain.Text.csproj" />
    <ProjectReference Include="..\shared\Plaintain.Components.Core\Plaintain.Components.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Plaintain.Cli.Tests" />
  </ItemGroup>

</Project>
