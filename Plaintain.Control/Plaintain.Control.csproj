<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The embeddable plaintext editing surface: PlainTextEditor (custom-drawn, uniform rows, a line-number
    gutter, an optional wrap) and the PlainTextEditorView that wraps it with a find bar and its own
    command catalog. Packaged as an Avalonia control library, kept apart from the Plaintain.Desktop
    shell that hosts it.

    The surface is *whole*: every command that acts on the open document lives here, never in a shell —
    which keeps the editor's behaviour in one place, testable without the window around it.

    The semantics — graphemes, selection, undo, search — are in shared/Plaintain.Text; the geometry is
    here, and it is row × lineHeight arithmetic.

    Dependency direction is strictly shell -> control -> shared; no upward references.
  -->
  <PropertyGroup>
    <RootNamespace>Plaintain.Control</RootNamespace>
    <AssemblyName>Plaintain.Control</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\Plaintain.Text\Plaintain.Text.csproj" />
    <!-- Shared command types (AppCommand / Shortcut) and chrome tokens, so the control can publish its own
         editing catalog for a host's Command Palette. -->
    <ProjectReference Include="..\shared\Plaintain.Components\Plaintain.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The standalone app shell (assembly name "Plaintain") and the headless UI tests reach a few
         internal seams on the surface control. -->
    <InternalsVisibleTo Include="Plaintain" />
    <InternalsVisibleTo Include="Plaintain.UiTests" />
  </ItemGroup>

</Project>
