<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Avalonia 12 desktop shell: single window, menu bar, status bar (encoding, line endings,
       caret position), file dialogs, recent files, settings. A thin host around the embeddable
       PlainTextEditorView — everything that acts on the open document lives in the control. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Plaintain.Desktop</RootNamespace>
    <AssemblyName>Plaintain</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Native AOT: the published app is one native executable, which starts in about a third of the
         time and memory of the JIT build. It also turns on the trim and AOT analyzers at build time,
         so code that would break under AOT (reflection-based JSON, for one) fails the build here
         rather than the published app at runtime. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plaintain.Control\Plaintain.Control.csproj" />
    <ProjectReference Include="..\shared\Plaintain.Components\Plaintain.Components.csproj" />
    <ProjectReference Include="..\shared\Plaintain.Components.Core\Plaintain.Components.Core.csproj" />
    <ProjectReference Include="..\shared\Plaintain.Text\Plaintain.Text.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Headless UI tests reach a few internal test seams. -->
    <InternalsVisibleTo Include="Plaintain.UiTests" />
  </ItemGroup>

</Project>
